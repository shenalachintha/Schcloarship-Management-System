{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Backend API",
			"type": "shell",
			"command": "dotnet",
			"args": [
				"run",
				"--project",
				"backend/ScholarshipManagement.API/ScholarshipManagement.API.csproj"
			],
			"isBackground": true,
			"problemMatcher": [],
